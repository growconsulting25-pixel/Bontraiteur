# ---------------------------------------------------------------------------
# Bon Traiteur — variables d'environnement
# Copier en .env.local (développement) et les ajouter sur Netlify (production).
# Chaque service est facultatif : sans lui, la fonctionnalité se désactive proprement.
# ---------------------------------------------------------------------------

# URL publique du site (liens de connexion, retours de paiement)
NEXT_PUBLIC_SITE_URL=https://bon-traiteur.netlify.app

# Supabase — Settings → API Keys (clé publishable : publique par conception)
NEXT_PUBLIC_SUPABASE_URL=https://daboizmggbbyzgjpwioy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase — clé SECRÈTE (service_role / secret key). Serveur seulement, jamais publique.
# Sert à inviter les utilisateurs (back-office) et au webhook Stripe.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers → API keys (commencer en mode test : sk_test_...)
STRIPE_SECRET_KEY=
# Stripe — Developers → Webhooks → endpoint https://<site>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Courriels (Resend) — avis à l'équipe et « votre menu est prêt »
RESEND_API_KEY=
EMAIL_FROM="Bon Traiteur <notifications@bontraiteur.com>"
# Adresse(s) de l'équipe qui reçoivent les alertes, séparées par des virgules
TEAM_NOTIFICATION_EMAIL=

# Rappels automatiques de confirmation de menu (fonction planifiée Netlify)
# Une longue chaîne aléatoire, ex. : openssl rand -hex 32
CRON_SECRET=

# --- Assistant virtuel ---
# L'assistant est guidé (sans IA) : aucune clé requise, aucun coût à l'usage.
